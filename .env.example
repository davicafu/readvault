# Copy to .env and adjust. Never commit .env.

# Postgres container (deploy/compose.yaml)
POSTGRES_USER=readvault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=readvault
POSTGRES_PORT=5432

# API (services/api)
DATABASE_URL=postgres://readvault:change-me@localhost:5432/readvault?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
# Upload and import limits
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_RECORDS=20000
